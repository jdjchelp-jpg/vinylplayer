{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BluePeak Vinyl Player",
  "version": "1.0.0",
  "identifier": "com.bluepeak.vinylplayer",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:8080",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BluePeak Vinyl Player",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
