{
  "name": "bluepeak-vinyl-player",
  "version": "1.0.0",
  "description": "A web-based vinyl record player interface that streams music from YouTube, local files, and direct audio URLs.",
  "private": true,
  "scripts": {
    "start": "npx http-server . -p 8080 -c-1",
    "dev": "npx http-server . -p 8080 -c-1 -o",
    "tauri:dev": "tauri dev",
    "prepare:dist": "node scripts/prepare-dist.mjs",
    "tauri:build": "npm run prepare:dist && tauri build"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "@tauri-apps/cli": "^2.9.0"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/plughead98/vinylplayer.git"
  }
}
